+		case IOCTL_WAIT_VE_DE:
+			ve_timeout = (int)arg;
+			cedar_devp->de_irq_value = 0;
+
+			spin_lock_irqsave(&cedar_devp->lock, flags);
+			if (cedar_devp->de_irq_flag)
