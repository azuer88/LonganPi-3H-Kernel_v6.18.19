+		case IOCTL_DISABLE_VE:
+			if ((cedar_devp->ve_clk == NULL) || IS_ERR(cedar_devp->ve_clk)) {
+				VE_LOGW("IOCTL_DISABLE_VE cedar_devp->ve_clk is invalid\n");
+				return -EFAULT;
