+					break;
+			}
+
+			if (i >= MAX_VE_DEBUG_INFO_NUM) {
+				VE_LOGW("SET_DEBUG_INFO  overflow  MAX_VE_DEBUG_INFO_NUM[%d]\n",
+					MAX_VE_DEBUG_INFO_NUM);
