+void sunxi_ve_debug_unregister_driver(void)
+{
+	if (cedar_devp->debug_root == NULL) {
+		VE_LOGW("note: debug root already is null\n");
+		return;
+	}
+	debugfs_remove_recursive(cedar_devp->debug_root);
+	cedar_devp->debug_root = NULL;
+}
+#endif
