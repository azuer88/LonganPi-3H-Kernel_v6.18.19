+#define sunxi_wait_when(COND, MS) ({ \
+	unsigned long timeout__ = jiffies + msecs_to_jiffies(MS) + 1;	\
+	int ret__ = 0;							\
+	while ((COND)) {						\
+		if (time_after(jiffies, timeout__)) {			\
+			ret__ = (!COND) ? 0 : -ETIMEDOUT;		\
+			break;						\
+		}							\
+		udelay(1);					\
+	}								\
+	ret__;								\
+})
