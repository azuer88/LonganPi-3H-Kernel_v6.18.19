+static const struct file_operations ve_debugfs_fops = {
+	.owner = THIS_MODULE,
+	.open = ve_debugfs_open,
+	.llseek = noop_llseek,
+	.read = ve_debugfs_read,
+	.release = ve_debugfs_release,
+};
