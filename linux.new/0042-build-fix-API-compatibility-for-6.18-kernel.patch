+static void set_system_register(void)
+{
+	/* modify ccmu and sys_config register config */
+#if (defined CONFIG_ARCH_SUNIVW1P1 || defined CONFIG_ARCH_SUN3IW1P1)
+	set_ccmu_by_self();
+#endif
+	set_sys_cfg_by_self();
+}
