From 66ba590d611bd84917989fbe4a6cc1ec02c86ce5 Mon Sep 17 00:00:00 2001
From: Blue Cuenca <blue.cuenca@gmail.com>
Date: Wed, 25 Mar 2026 05:13:16 +0000
Subject: [PATCH 41/48] dts: remove duplicate vendor iommu and ve nodes
 conflicting with upstream

---
 .../arm64/boot/dts/allwinner/sun50i-h616.dtsi | 28 -------------------
 .../dts/allwinner/sun50i-h618-longanpi-3h.dts |  9 ------
 2 files changed, 37 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
index e67613664..853730bf8 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -228,34 +228,6 @@ mixer0_out_tcon_top_mixer0: endpoint {
 			};
 		};
 
-		mmu_aw: iommu@30f0000 {
-			compatible = "allwinner,iommu-v12-sun50iw9";
-			reg = <0x030f0000 0x1000>;
-			interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
-			interrupt-names = "iommu-irq";
-			clocks = <&ccu CLK_BUS_IOMMU>;
-			clock-names = "iommu";
-			#iommu-cells = <2>;
-		};
-
-		ve: ve@1c0e000 {
-			compatible = "allwinner,sunxi-cedar-ve";
-			reg = <0x01c0e000 0x1000>,
-			      <0x03000000 0x10>,
-			      <0x03001000 0x1000>;
-			interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&ccu CLK_BUS_VE>, <&ccu CLK_VE>, <&ccu CLK_MBUS_VE>;
-			clock-names = "bus_ve", "ve", "mbus_ve";
-			resets = <&ccu RST_BUS_VE>;
-			iommus = <&mmu_aw 3 1>;
-			status="disabled";
-		};
-
-		ve1: ve1@1c0e000 {
-			compatible = "allwinner,sunxi-cedar-ve";
-			iommus = <&mmu_aw 2 1>;
-			status="disabled";
-		};
 
 		syscon: syscon@3000000 {
 			compatible = "allwinner,sun50i-h616-system-control";
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h618-longanpi-3h.dts b/arch/arm64/boot/dts/allwinner/sun50i-h618-longanpi-3h.dts
index c7a449dec..f072f2ae5 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h618-longanpi-3h.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-longanpi-3h.dts
@@ -19,8 +19,6 @@ aliases {
 		ethernet0 = &emac0;
 		ethernet1 = &emac1;
 		serial0 = &uart0;
-		ve0 = &ve;
-		ve1 = &ve1;
 	};
 
 	chosen {
@@ -204,14 +202,7 @@ &uart1 {
 	status = "okay";
 };
 
-&ve {
-	ve-supply = <&reg_dldo1>;
-	status="okay";
-};
 
-&ve1 {
-	status="okay";
-};
 
 &spi1 {
 	pinctrl-0 = <&spi1_pins>, <&spi1_cs0_pin>;
-- 
