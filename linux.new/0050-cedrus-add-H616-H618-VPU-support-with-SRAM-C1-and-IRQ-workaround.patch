From bc1ba6f12f0e8d6c69f5bbdc35aa04d34ef94bc9 Mon Sep 17 00:00:00 2001
From: Blue Cuenca <blue.cuenca@gmail.com>
Date: Sat, 28 Mar 2026 13:59:10 +0000
Subject: [PATCH] cedrus: add H616/H618 VPU support with SRAM C1 and IRQ
 workaround

Enable the Cedrus VPU on Allwinner H616/H618 (LonganPi 3H).

The H616/H618 has a dedicated VE SRAM region (C1) at 0x01a00000
(2 MiB). Earlier code marked H616 with CEDRUS_QUIRK_NO_SRAM and
omitted the allwinner,sram DTS property, causing cedrus to skip SRAM
initialisation and produce broken output.

Changes:
- sunxi_sram.c: add sun50i-h616-sram-c1 descriptor and DT match entry
- sun50i-h616.dtsi: add sram_c1 node and allwinner,sram to VE node
- cedrus.c/h: add CEDRUS_QUIRK_NO_SRAM flag; H616 variant has no quirk
- cedrus_hw.c: make sunxi_sram_claim/release conditional on quirk flag
- cedrus_h264.c: fix VLD/deblk/intra buffer setup for H616
- longanpi_3h_defconfig: enable cedrus and required media framework options

On H616/H618 the VE interrupt line never reaches the GIC (SLICE_DECODE_INT
is set in the hardware status register, but IRQ 121 count stays zero).
Work around this by checking irq_status() at the start of the watchdog
handler: if the hardware completed successfully, finish the job normally
instead of declaring a timeout. Reduce the watchdog delay to 50 ms to
keep per-frame latency acceptable.

Tested: H264 decode at 1920x1080 working on lpi3h-f1a0 (H618 board).
---
 .../arm64/boot/dts/allwinner/sun50i-h616.dtsi | 24 +++++++
 arch/arm64/configs/longanpi_3h_defconfig      | 15 +++--
 drivers/soc/sunxi/sunxi_sram.c                | 10 +++
 drivers/staging/media/sunxi/cedrus/cedrus.c   | 18 +++++
 drivers/staging/media/sunxi/cedrus/cedrus.h   |  4 ++
 .../staging/media/sunxi/cedrus/cedrus_dec.c   |  2 +-
 .../staging/media/sunxi/cedrus/cedrus_h264.c  | 45 +++++++++----
 .../staging/media/sunxi/cedrus/cedrus_hw.c    | 66 +++++++++++++++++--
 8 files changed, 160 insertions(+), 24 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
index fa5b5eca8..b45c80c19 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -159,6 +159,17 @@ soc {
 		#size-cells = <1>;
 		ranges = <0x0 0x0 0x0 0x40000000>;
 
+		video-codec@1c0e000 {
+			compatible = "allwinner,sun50i-h616-video-engine";
+			reg = <0x01c0e000 0x2000>;
+			clocks = <&ccu CLK_BUS_VE>, <&ccu CLK_VE>,
+				 <&ccu CLK_MBUS_VE>;
+			clock-names = "ahb", "mod", "ram";
+			resets = <&ccu RST_BUS_VE>;
+			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
+			allwinner,sram = <&ve_sram 1>;
+		};
+
 		gpu: gpu@1800000 {
 			compatible = "allwinner,sun50i-h616-mali",
 				     "arm,mali-bifrost";
@@ -252,6 +263,19 @@ de3_sram: sram-section@0 {
 			};
 		};
 
+		sram_c1: sram@1a00000 {
+			compatible = "mmio-sram";
+			reg = <0x01a00000 0x200000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0 0x01a00000 0x200000>;
+
+			ve_sram: sram-section@0 {
+				compatible = "allwinner,sun50i-h616-sram-c1";
+				reg = <0x000000 0x200000>;
+			};
+		};
+
 		ccu: clock@3001000 {
 			compatible = "allwinner,sun50i-h616-ccu";
 			reg = <0x03001000 0x1000>;
