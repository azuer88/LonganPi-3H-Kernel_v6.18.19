diff --git a/drivers/soc/sunxi/sunxi_sram.c b/drivers/soc/sunxi/sunxi_sram.c
index 446b9fc1f..d7c121960 100644
--- a/drivers/soc/sunxi/sunxi_sram.c
+++ b/drivers/soc/sunxi/sunxi_sram.c
@@ -82,6 +82,12 @@ static struct sunxi_sram_desc sun50i_a64_sram_c = {
 				  SUNXI_SRAM_MAP(0, 1, "de2")),
 };
 
+static struct sunxi_sram_desc sun50i_h616_sram_c1 = {
+	.data	= SUNXI_SRAM_DATA("C1", 0x0, 0x0, 31,
+				  SUNXI_SRAM_MAP(0x7fffffff, 0, "cpu"),
+				  SUNXI_SRAM_MAP(0, 1, "ve")),
+};
+
 static const struct of_device_id sunxi_sram_dt_ids[] = {
 	{
 		.compatible	= "allwinner,sun4i-a10-sram-a3-a4",
@@ -99,6 +105,10 @@ static const struct of_device_id sunxi_sram_dt_ids[] = {
 		.compatible	= "allwinner,sun50i-a64-sram-c",
 		.data		= &sun50i_a64_sram_c.data,
 	},
+	{
+		.compatible	= "allwinner,sun50i-h616-sram-c1",
+		.data		= &sun50i_h616_sram_c1.data,
+	},
 	{}
 };
 
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index bff42ea18..b63126ebc 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -647,6 +647,16 @@ static const struct cedrus_variant sun50i_h6_cedrus_variant = {
 	.mod_rate	= 600000000,
 };
 
+static const struct cedrus_variant sun50i_h616_cedrus_variant = {
+	.capabilities	= CEDRUS_CAPABILITY_UNTILED |
+			  CEDRUS_CAPABILITY_MPEG2_DEC |
+			  CEDRUS_CAPABILITY_H264_DEC |
+			  CEDRUS_CAPABILITY_H265_DEC |
+			  CEDRUS_CAPABILITY_H265_10_DEC |
+			  CEDRUS_CAPABILITY_VP8_DEC,
+	.mod_rate	= 600000000,
+};
+
 static const struct of_device_id cedrus_dt_match[] = {
 	{
 		.compatible = "allwinner,sun4i-a10-video-engine",
@@ -692,6 +702,14 @@ static const struct of_device_id cedrus_dt_match[] = {
 		.compatible = "allwinner,sun50i-h6-video-engine",
 		.data = &sun50i_h6_cedrus_variant,
 	},
+	{
+		.compatible = "allwinner,sun50i-h616-video-engine",
+		.data = &sun50i_h616_cedrus_variant,
+	},
+	{
+		.compatible = "allwinner,sun50i-h618-video-engine",
+		.data = &sun50i_h616_cedrus_variant,
+	},
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, cedrus_dt_match);
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
index c4b1217c1..6819992ab 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -29,6 +29,8 @@
 #define CEDRUS_NAME			"cedrus"
 
 #define CEDRUS_CAPABILITY_UNTILED	BIT(0)
+
+#define CEDRUS_QUIRK_NO_SRAM		BIT(0)
 #define CEDRUS_CAPABILITY_H265_DEC	BIT(1)
 #define CEDRUS_CAPABILITY_H264_DEC	BIT(2)
 #define CEDRUS_CAPABILITY_MPEG2_DEC	BIT(3)
@@ -173,6 +175,7 @@ struct cedrus_dec_ops {
 };
 
 struct cedrus_variant {
+	unsigned int	quirks;
 	unsigned int	capabilities;
 	unsigned int	mod_rate;
 };
@@ -198,6 +201,7 @@ struct cedrus_dev {
 	struct reset_control	*rstc;
 
 	unsigned int		capabilities;
+	unsigned int		quirks;
 
 	struct delayed_work	watchdog_work;
 };
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
index fbbf9e6f0..193730af6 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
@@ -108,7 +108,7 @@ void cedrus_device_run(void *priv)
 	if (!error) {
 		/* Start the watchdog timer. */
 		schedule_delayed_work(&dev->watchdog_work,
-				      msecs_to_jiffies(2000));
+				      msecs_to_jiffies(50));
 
 		ctx->current_codec->trigger(ctx);
 	} else {
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_h264.c b/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
index 3e2843ef6..9c3a9923a 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
@@ -321,24 +321,34 @@ static void cedrus_write_pred_weight_table(struct cedrus_ctx *ctx,
  * rare cases frame is not decoded correctly. However, setting offset to 0 and
  * skipping appropriate amount of bits with flush bits trigger always works.
  */
-static void cedrus_skip_bits(struct cedrus_dev *dev, int num)
+static int cedrus_skip_bits(struct cedrus_dev *dev, int num)
 {
 	int count = 0;
 
 	while (count < num) {
 		int tmp = min(num - count, 32);
+		int i;
 
 		cedrus_write(dev, VE_H264_TRIGGER_TYPE,
 			     VE_H264_TRIGGER_TYPE_FLUSH_BITS |
 			     VE_H264_TRIGGER_TYPE_N_BITS(tmp));
-		while (cedrus_read(dev, VE_H264_STATUS) & VE_H264_STATUS_VLD_BUSY)
+		for (i = 0; i < 100000; i++) {
+			if (!(cedrus_read(dev, VE_H264_STATUS) &
+			      VE_H264_STATUS_VLD_BUSY))
+				break;
 			udelay(1);
+		}
+		if (i == 100000) {
+			dev_err(dev->dev, "cedrus: VLD timeout in skip_bits\n");
+			return -ETIMEDOUT;
+		}
 
 		count += tmp;
 	}
+	return 0;
 }
 
-static void cedrus_set_params(struct cedrus_ctx *ctx,
+static int cedrus_set_params(struct cedrus_ctx *ctx,
 			      struct cedrus_run *run)
 {
 	const struct v4l2_ctrl_h264_decode_params *decode = run->h264.decode_params;
@@ -378,15 +388,27 @@ static void cedrus_set_params(struct cedrus_ctx *ctx,
 	}
 
 	/*
-	 * FIXME: Since the bitstream parsing is done in software, and
-	 * in userspace, this shouldn't be needed anymore. But it
-	 * turns out that removing it breaks the decoding process,
-	 * without any clear indication why.
+	 * Initialize the VLD, then wait for completion before advancing
+	 * past the slice header. INIT_SWDEC must complete before FLUSH_BITS
+	 * to avoid a race where FLUSH_BITS overwrites running INIT_SWDEC.
 	 */
 	cedrus_write(dev, VE_H264_TRIGGER_TYPE,
 		     VE_H264_TRIGGER_TYPE_INIT_SWDEC);
-
-	cedrus_skip_bits(dev, slice->header_bit_size);
+	{
+		int i;
+		for (i = 0; i < 100000; i++) {
+			if (!(cedrus_read(dev, VE_H264_STATUS) &
+			      VE_H264_STATUS_VLD_BUSY))
+				break;
+			udelay(1);
+		}
+		if (i == 100000) {
+			dev_err(dev->dev, "cedrus: VLD timeout after INIT_SWDEC\n");
+			return -ETIMEDOUT;
+		}
+	}
+	if (cedrus_skip_bits(dev, slice->header_bit_size))
+		return -ETIMEDOUT;
 
 	if (V4L2_H264_CTRL_PRED_WEIGHTS_REQUIRED(pps, slice))
 		cedrus_write_pred_weight_table(ctx, run);
@@ -478,6 +500,7 @@ static void cedrus_set_params(struct cedrus_ctx *ctx,
 		     VE_H264_CTRL_SLICE_DECODE_INT |
 		     VE_H264_CTRL_DECODE_ERR_INT |
 		     VE_H264_CTRL_VLD_DATA_REQ_INT);
+	return 0;
 }
 
 static enum cedrus_irq_status
@@ -531,9 +554,7 @@ static int cedrus_h264_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 	if (ret)
 		return ret;
 
-	cedrus_set_params(ctx, run);
-
-	return 0;
+	return cedrus_set_params(ctx, run);
 }
 
 static int cedrus_h264_start(struct cedrus_ctx *ctx)
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
index 444fb5387..a1168ce60 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -134,7 +134,6 @@ static irqreturn_t cedrus_irq(int irq, void *data)
 	struct cedrus_ctx *ctx;
 	enum vb2_buffer_state state;
 	enum cedrus_irq_status status;
-
 	/*
 	 * If cancel_delayed_work returns false it means watchdog already
 	 * executed and finished the job.
@@ -171,6 +170,8 @@ void cedrus_watchdog(struct work_struct *work)
 {
 	struct cedrus_dev *dev;
 	struct cedrus_ctx *ctx;
+	enum cedrus_irq_status irq_status;
+	enum vb2_buffer_state state;
 
 	dev = container_of(to_delayed_work(work),
 			   struct cedrus_dev, watchdog_work);
@@ -179,7 +180,53 @@ void cedrus_watchdog(struct work_struct *work)
 	if (!ctx)
 		return;
 
+	/*
+	 * Check if hardware completed but the interrupt never fired
+	 * (observed on H616: SLICE_DECODE_INT set but GIC never asserted).
+	 * If so, complete the job normally instead of declaring a timeout.
+	 */
+	irq_status = ctx->current_codec->irq_status(ctx);
+	if (irq_status != CEDRUS_IRQ_NONE) {
+		ctx->current_codec->irq_disable(ctx);
+		ctx->current_codec->irq_clear(ctx);
+		state = (irq_status == CEDRUS_IRQ_OK) ?
+			VB2_BUF_STATE_DONE : VB2_BUF_STATE_ERROR;
+		v4l2_m2m_buf_done_and_job_finish(dev->m2m_dev,
+						 ctx->fh.m2m_ctx, state);
+		return;
+	}
+
 	v4l2_err(&dev->v4l2_dev, "frame processing timed out!\n");
+	/* Dump key VE registers to diagnose H264 decode hang */
+	{
+		u32 mode = readl(dev->base + 0x00);
+		u32 buf_ctrl = readl(dev->base + 0x50);
+		u32 dblk_addr = readl(dev->base + 0x54);
+		u32 intra_addr = readl(dev->base + 0x58);
+		u32 h264_status = readl(dev->base + 0x200 + 0x28);
+		u32 h264_vld_off = readl(dev->base + 0x200 + 0x34);
+		u32 h264_vld_len = readl(dev->base + 0x200 + 0x38);
+		u32 h264_ctrl = readl(dev->base + 0x200 + 0x20);
+		u32 extra_buf1 = readl(dev->base + 0x200 + 0x50);
+		u32 extra_buf2 = readl(dev->base + 0x200 + 0x54);
+		u32 h264_vld_addr = readl(dev->base + 0x200 + 0x30);
+		u32 cur_mb_num = readl(dev->base + 0x200 + 0x2c);
+		u32 error_case = readl(dev->base + 0x200 + 0xb8);
+		u32 prim_out_fmt = readl(dev->base + 0xec);
+		u32 prim_stride = readl(dev->base + 0xc8);
+		v4l2_err(&dev->v4l2_dev,
+			 "VE regs: mode=%08x buf_ctrl=%08x dblk=%08x intra=%08x\n",
+			 mode, buf_ctrl, dblk_addr, intra_addr);
+		v4l2_err(&dev->v4l2_dev,
+			 "H264 regs: ctrl=%08x status=%08x vld_off=%08x vld_len=%08x\n",
+			 h264_ctrl, h264_status, h264_vld_off, h264_vld_len);
+		v4l2_err(&dev->v4l2_dev,
+			 "H264 regs: vld_addr=%08x extra1=%08x extra2=%08x\n",
+			 h264_vld_addr, extra_buf1, extra_buf2);
+		v4l2_err(&dev->v4l2_dev,
+			 "H264 regs: cur_mb=%08x error=%08x prim_fmt=%08x stride=%08x\n",
+			 cur_mb_num, error_case, prim_out_fmt, prim_stride);
+	}
 	reset_control_reset(dev->rstc);
 	v4l2_m2m_buf_done_and_job_finish(ctx->dev->m2m_dev, ctx->fh.m2m_ctx,
 					 VB2_BUF_STATE_ERROR);
@@ -254,6 +301,7 @@ int cedrus_hw_probe(struct cedrus_dev *dev)
 		return -EINVAL;
 
 	dev->capabilities = variant->capabilities;
+	dev->quirks = variant->quirks;
 
 	irq_dec = platform_get_irq(dev->pdev, 0);
 	if (irq_dec <= 0)
@@ -273,11 +321,13 @@ int cedrus_hw_probe(struct cedrus_dev *dev)
 		return ret;
 	}
 
-	ret = sunxi_sram_claim(dev->dev);
-	if (ret) {
-		dev_err(dev->dev, "Failed to claim SRAM\n");
+	if (!(variant->quirks & CEDRUS_QUIRK_NO_SRAM)) {
+		ret = sunxi_sram_claim(dev->dev);
+		if (ret) {
+			dev_err(dev->dev, "Failed to claim SRAM\n");
 
-		goto err_mem;
+			goto err_mem;
+		}
 	}
 
 	dev->ahb_clk = devm_clk_get(dev->dev, "ahb");
@@ -339,7 +389,8 @@ int cedrus_hw_probe(struct cedrus_dev *dev)
 err_pm:
 	pm_runtime_disable(dev->dev);
 err_sram:
-	sunxi_sram_release(dev->dev);
+	if (!(dev->quirks & CEDRUS_QUIRK_NO_SRAM))
+		sunxi_sram_release(dev->dev);
 err_mem:
 	of_reserved_mem_device_release(dev->dev);
 
@@ -352,7 +403,8 @@ void cedrus_hw_remove(struct cedrus_dev *dev)
 	if (!pm_runtime_status_suspended(dev->dev))
 		cedrus_hw_suspend(dev->dev);
 
-	sunxi_sram_release(dev->dev);
+	if (!(dev->quirks & CEDRUS_QUIRK_NO_SRAM))
+		sunxi_sram_release(dev->dev);
 
 	of_reserved_mem_device_release(dev->dev);
 }
-- 
2.34.1

