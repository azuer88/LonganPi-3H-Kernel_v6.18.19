# Required
MACID=e8519ee8f1a0           # board WiFi MAC; used for hostname, SSH keys, WiFi config
USER_NAME=default
USER_PASS=yourpassword       # plaintext; hashed with openssl passwd -6 at build time
AUTHORIZED_KEY="ssh-ed25519 AAAA... user@host"
SSID=mywifi
PKEY=wpapassphrase
TIMEZONE=America/Los_Angeles
NTP_SERVER=pool.ntp.org

# Optional
#NOGUI=0                      # set 1 to skip XFCE desktop
#NOPASS_SUDO=0                # set 1 to add user to NOPASSWD sudoers
#APT_PROXY=http://aptcacheserver:8080   # used if reachable; else skipped
#APT_PROXY_FALLBACK=http://localhost:8080  # mkrootfs.sh fallback only; ignored by 06_update_apt_proxy.sh
#IMAGE_NAME=sdcard-$MACID     # output image filename override
#CODENAME=bookworm            # Debian release; omit for default (bookworm); affects rootfs/image filenames
#USER_PACKAGE=                # extra packages to include in debootstrap (space-separated)
