Subject: [PATCH 56/56] defconfig: add HDMI I2S audio drivers
 (DRM_DW_HDMI_I2S_AUDIO, SND_SUN4I_I2S)


diff --git a/arch/arm64/configs/longanpi_3h_defconfig b/arch/arm64/configs/longanpi_3h_defconfig
index 476254b1a..a75613d16 100644
--- a/arch/arm64/configs/longanpi_3h_defconfig
+++ b/arch/arm64/configs/longanpi_3h_defconfig
@@ -1085,6 +1085,8 @@ CONFIG_CRYPTO_DEV_SUN8I_SS=m
 CONFIG_CRYPTO_DEV_SUN8I_SS_DEBUG=y
 CONFIG_CRYPTO_DEV_SUN8I_SS_PRNG=y
 CONFIG_CRYPTO_DEV_SUN8I_SS_HASH=y
+CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
+CONFIG_SND_SUN4I_I2S=y
 CONFIG_DMA_CMA=y
 CONFIG_PRINTK_TIME=y
 # CONFIG_DEBUG_BUGVERBOSE is not set
