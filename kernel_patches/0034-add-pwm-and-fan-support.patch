 		regulator-always-on;
 		vin-supply = <&reg_vcc5v>;
 	};
+
+	fan0: pwm-fan {
+        compatible = "pwm-fan";
+        cooling-levels = <1 100 150 200 255>;
+        #cooling-cells = <2>;
+		pwms = <&pwm 2 50000 1>;
+		status = "okay";
+    };
+
+	thermal-zones {
+		cpu-thermal {
+			cooling-maps {
+				map0 {
+					trip = <&cpu_threshold>;
+					cooling-device = <&fan0 0 2>;
+				};
+				map1 {
+					trip = <&cpu_target>;
+					cooling-device = <&fan0 2 4>;
+				};
+			};
+		};
+	};
 };
 
